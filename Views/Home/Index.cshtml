@model WebAppForm.Models.PersonDetails
@{ ViewData["Title"] = "Basic Details"; }

<h2>Basic Details</h2>
<form asp-action="Index" method="post">
    <div asp-validation-summary="ModelOnly" class="error"></div>
    <div class="field">
        <label asp-for="FirstName"></label>
        <input asp-for="FirstName" />
        <span asp-validation-for="FirstName" class="error"></span>
    </div>
    <div class="field">
        <label asp-for="LastName"></label>
        <input asp-for="LastName" />
        <span asp-validation-for="LastName" class="error"></span>
    </div>
    <div class="field">
        <label asp-for="DOB"></label>
        <input asp-for="DOB" type="date" />
        <span asp-validation-for="DOB" class="error"></span>
    </div>
    <div class="field">
        <label asp-for="Location"></label>
        <input asp-for="Location" />
        <span asp-validation-for="Location" class="error"></span>
    </div>
    <button type="submit">Submit</button>
</form>
